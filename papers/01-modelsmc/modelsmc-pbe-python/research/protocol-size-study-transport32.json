{
  "schema_version": 2,
  "protocol_id": "modelsmc-pbe-size-study-transport32-v2",
  "status": "frozen-exploratory-transport-amendment-before-rerun",
  "amendment": {
    "classification": "exploratory-transport-only",
    "supersedes_protocol": "protocol.json",
    "supersedes_protocol_sha256": "095f7ad83eaea20168a14764ec501fb916b1c9677ed3d988998ed34402b9b0e2",
    "trigger": "Gate 2 on the 32B server encountered an HTTP 524 during a signed-window finite-candidate scoring request with candidate_batch_size=128.",
    "single_intended_change": "Reduce candidate_batch_size from 128 to 32 without changing candidate support, proposal-score budget, prompts, energies, seeds, particles, stages, or endpoints.",
    "analysis_policy": "Treat every run under the superseded hash as preflight. Rerun all four 32B Gate-2 task-by-arm cells under this hash, and use only this amended protocol for later size-study allocations. Do not pool superseded and amended Gate-2 outcomes."
  },
  "study_scope": {
    "primary_question": "Do deduction and finite-choice Qwen scores improve exact program discovery under a fixed proposal-score budget?",
    "primary_endpoint": "paired intention-to-treat exact-discovery rate",
    "secondary_endpoints": [
      "held-out exact correctness",
      "candidate scores to first exact program",
      "wall time",
      "final and minimum ESS",
      "total-variation distance to finite enumeration",
      "absolute log-normalizer error"
    ],
    "confirmatory_caveat": "All benchmark task families were visible during system development. Confirmatory labels apply only to fresh, frozen seed-by-arm replications created after this protocol is frozen; they do not establish unseen-task generalization.",
    "failure_policy": "Every planned cell remains in the analysis. Timeout, provider failure, invalid output, missing artifact, or non-exact training result counts as failure for the primary endpoint.",
    "multiplicity": "Report all arm contrasts; treat QD versus U as primary and D versus U, Q versus U, and QD versus D/Q as secondary.",
    "exploratory_policy": "This transport amendment and every run under it remain exploratory. The amendment was chosen after observing a provider/proxy failure, not an algorithmic outcome."
  },
  "seeds": [101, 211, 307, 401, 503],
  "caps": {
    "particles": 8,
    "iterations": 3,
    "alpha": 0.0,
    "ess_threshold": 1.0,
